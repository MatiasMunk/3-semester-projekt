@using StudyGroups.Contracts
@{
    Layout = "_PortalLayout";
    var categories = ViewBag.Categories as List<CategoryDto> ?? new List<CategoryDto>();
}

@model StudyGroups.Contracts.CreateStudySessionRequest

<h2>Create Study Session</h2>

@if (!ViewData.ModelState.IsValid)
{
    <div style="padding:12px; margin-bottom:16px; background:#fee2e2; color:#991b1b; border:1px solid #fecaca; border-radius:8px;">
        <div asp-validation-summary="All"></div>
    </div>
}

@if (categories.Count == 0)
{
    <div style="padding:12px; margin-bottom:16px; background:#fef3c7; color:#92400e; border:1px solid #fde68a; border-radius:8px;">
        No categories exist yet. Add categories first from the native client Categories page, or seed the Topics table.
    </div>
}

<form method="post">
    <input type="hidden" asp-for="UserId" />

    <div>
        <label>Title</label>
        <input asp-for="Title" />
    </div>

    <div>
        <label>Topic</label>
        <select asp-for="TopicId" disabled="@(categories.Count == 0)">
            @foreach (var category in categories)
            {
                <option value="@category.Id">@category.Icon @category.Name</option>
            }
        </select>
    </div>

    <div>
        <label>Location</label>
        <input asp-for="Location" />
    </div>

    <div>
        <label>Start Time</label>
        <input asp-for="StartTime" type="datetime-local" />
    </div>

    <div>
        <label>Max Participants</label>
        <input asp-for="MaxParticipants" type="number" min="1" />
    </div>

    <button type="submit" disabled="@(categories.Count == 0)">Create</button>
</form>
