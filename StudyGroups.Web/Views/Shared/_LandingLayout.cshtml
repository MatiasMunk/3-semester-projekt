@using Microsoft.AspNetCore.Mvc.Localization
@using System.Globalization
@inject IViewLocalizer L

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – Study Groups</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&display=swap" rel="stylesheet">

    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --navy:   #0f172a;
            --navy2:  #1e293b;
            --indigo: #4338ca;
            --amber:  #f59e0b;
            --amber2: #fbbf24;
            --cream:  #faf9f7;
            --gray:   #64748b;
            --light:  #f1f5f9;
            --white:  #ffffff;
            --radius: 14px;
            --shadow: 0 4px 24px rgba(15,23,42,0.10);
            --shadow-lg: 0 12px 48px rgba(15,23,42,0.18);
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--cream);
            color: var(--navy);
            -webkit-font-smoothing: antialiased;
        }

        /* ─── NAVBAR ─────────────────────────────────── */
        .active-lang {
            background: var(--indigo);
            color: white;
        }

        .topbar {
            position: sticky;
            top: 0;
            z-index: 100;
            height: 70px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 clamp(20px, 5vw, 60px);
            background: rgba(255,255,255,0.92);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(15,23,42,0.08);
        }

        .logo {
            font-family: 'Playfair Display', serif;
            font-weight: 700;
            font-size: 22px;
            color: var(--navy);
            text-decoration: none;
            letter-spacing: -0.5px;
        }

        .logo span { color: var(--indigo); }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .nav-links a {
            text-decoration: none;
            color: var(--gray);
            font-size: 15px;
            font-weight: 500;
            padding: 8px 14px;
            border-radius: 8px;
            transition: color 0.2s, background 0.2s;
        }

        .nav-links a:hover { color: var(--navy); background: var(--light); }

        .nav-links .btn-nav {
            background: var(--indigo);
            color: white;
            padding: 9px 20px;
            border-radius: 9px;
            font-weight: 600;
            margin-left: 6px;
        }

        .nav-links .btn-nav:hover { background: #3730a3; color: white; }

        /* LANGUAGE DROPDOWN */
        .lang-dropdown {
            position: relative;
        }

        .lang-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 6px 10px;
            border: none;
            background: transparent;
            cursor: pointer;
        }

        .flag-icon {
            width: 20px;
            height: 14px;
            object-fit: cover;
            border-radius: 2px;
        }

        .lang-menu {
            position: absolute;
            top: 120%;
            right: 0;
            background: white;
            border: 1px solid rgba(15,23,42,0.1);
            border-radius: 10px;
            box-shadow: var(--shadow);
            display: none;
            flex-direction: column;
            min-width: 140px;
            z-index: 999;
        }

        .lang-menu a {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 14px;
            text-decoration: none;
            color: var(--navy);
            font-size: 14px;
        }

        .lang-menu.open {
            display: flex;
        }

        .lang-menu a:hover {
            background: var(--light);
        }

        .btn-outline {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 14px;
            border-radius: 8px;
            border: 1px solid rgba(15,23,42,0.2);
            text-decoration: none;
            font-size: 14px;
            color: var(--navy);
            transition: background 0.2s, border-color 0.2s;
        }

        .btn-outline:hover {
            background: var(--light);
        }

        /* hamburger */
        .hamburger {
            display: none;
            flex-direction: column;
            gap: 5px;
            cursor: pointer;
            padding: 4px;
            border: none;
            background: none;
        }

        .hamburger span {
            display: block;
            width: 24px;
            height: 2px;
            background: var(--navy);
            border-radius: 2px;
            transition: transform 0.3s, opacity 0.3s;
        }

        .hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
        .hamburger.open span:nth-child(2) { opacity: 0; }
        .hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

        .mobile-menu {
            display: none;
            position: fixed;
            top: 70px;
            left: 0;
            right: 0;
            background: white;
            border-bottom: 1px solid var(--light);
            padding: 16px clamp(20px, 5vw, 60px);
            flex-direction: column;
            gap: 4px;
            z-index: 99;
            box-shadow: var(--shadow);
        }

        .mobile-menu.open { display: flex; }

        .mobile-menu a {
            text-decoration: none;
            color: var(--navy);
            font-size: 16px;
            font-weight: 500;
            padding: 12px 0;
            border-bottom: 1px solid var(--light);
        }

        .mobile-menu a:last-child { border-bottom: none; }

        @@media (max-width: 640px) {
            .nav-links { display: none; }
            .hamburger { display: flex; }
        }
    </style>
</head>

<body>
    <nav class="topbar">
        <a href="/" class="logo">Study <span>Groups</span></a>

        <div class="nav-links">
            <!-- LANGUAGE DROPDOWN -->
            <div class="lang-dropdown">
                <button class="lang-btn" onclick="toggleLangMenu()">
                    @{
                        var currentLang = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
                        var flagSrc = currentLang == "da"
                            ? "/images/flags/dk.svg"
                            : "/images/flags/gb.svg";
                    }
                    <img src="@flagSrc" alt="lang" class="flag-icon" />
                </button>

                <div class="lang-menu" id="langMenu">
                    <a href="/Home/SetLanguage?culture=en&returnUrl=@(Context.Request.Path + Context.Request.QueryString)">
                        <img src="/images/flags/gb.svg" class="flag-icon" /> English
                    </a>
                    <a href="/Home/SetLanguage?culture=da&returnUrl=@(Context.Request.Path + Context.Request.QueryString)">
                        <img src="/images/flags/dk.svg" class="flag-icon" /> Dansk
                    </a>
                </div>
            </div>

            <a href="/">@L["FooterHome"]</a>
            <a href="/Sessions">@L["FooterSessions"]</a>

            <a href="/Sessions" class="btn-nav">@L["HeroPrimaryBtn"]</a>
        </div>

        <button class="hamburger" id="hamburger" aria-label="Menu">
            <span></span><span></span><span></span>
        </button>

        
    </nav>

    <div class="mobile-menu" id="mobileMenu">
        <a href="/">@L["FooterHome"]</a>
        <a href="/Sessions">@L["FooterSessions"]</a>
        <a href="/Sessions" style="color: var(--indigo); font-weight: 600;">@L["HeroPrimaryBtn"]</a>
    </div>

    @RenderBody()

    <script>
        const hamburger = document.getElementById('hamburger');
        const mobileMenu = document.getElementById('mobileMenu');
        hamburger.addEventListener('click', () => {
            hamburger.classList.toggle('open');
            mobileMenu.classList.toggle('open');
        });

        // Language select interaction
        function toggleLangMenu() {
            document.getElementById("langMenu").classList.toggle("open");
        }

        // close when clicking outside
        document.addEventListener("click", function (e) {
            const dropdown = document.querySelector(".lang-dropdown");
            if (dropdown && !dropdown.contains(e.target)) {
                document.getElementById("langMenu").classList.remove("open");
            }
        });
    </script>
</body>
</html>
